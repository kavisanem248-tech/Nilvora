# ==============================================================================
# NILVORA — Environment Configuration Blueprint
# Note: Keep this file updated with placeholders only. Never commit real secrets.
# ==============================================================================

# Core Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_PRIMARY_MARKET=ambattur-chennai

# Supabase (PostgreSQL & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Storage Buckets (Private & Public)
SUPABASE_STORAGE_PUBLIC_BUCKET=nilvora-public-media
SUPABASE_STORAGE_PRIVATE_BUCKET=nilvora-private-documents

# Payment Gateway (Razorpay India)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# Maps Provider (Mapbox / Google Maps / OpenStreetMap)
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
NEXT_PUBLIC_MAPS_API_KEY=your-map-api-key-placeholder

# AI & LLM Provider (Google Gemini; keep the key server-side)
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-3.8-flash

# Document OCR & Intelligence Provider (Tesseract / Google Cloud Vision / AWS Textract)
OCR_PROVIDER=simulated_and_tesseract
OCR_API_KEY=your-ocr-key-placeholder

# Communications & Notifications
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key-placeholder
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your-msg91-key-placeholder

# DigiLocker Integration Boundary (Government of India)
DIGILOCKER_CLIENT_ID=your-digilocker-client-id
DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/auth/digilocker/callback
DIGILOCKER_ENV=sandbox

# Compliance Engine
DEFAULT_STATE_CODE=TN
RERA_TN_URL=https://www.rera.tn.gov.in
TNREGISTRATION_URL=https://tnreginet.gov.in
